# Скопируй в .env и заполни реальными значениями
# Файл .env НЕ коммитится в Git (уже в .gitignore)
#
# Имена ITOPS_* — основные (общие для любой организации).
# Старые имена AGMK_* по-прежнему работают: если ITOPS_-переменная не задана,
# скрипты автоматически берут AGMK_-вариант. Переименовывать рабочий .env
# не требуется.

# --- Control plane ---
ITOPS_TENANT_SLUG=agmk
ITOPS_CONTROL_PLANE_URL=http://itops-control-plane:8090

ITOPS_TENANT_ID=your-tenant-id-here
ITOPS_CLIENT_ID=your-app-client-id-here
ITOPS_CERT_PATH=/path/to/your/cert.pfx
ITOPS_MANAGER_UPN=i.nagorny@upmoagmk.uz

# Общий ключ между каналами (web, telegram) и Core API.
# Сгенерируй свой: openssl rand -hex 32
CORE_API_KEY=generate-me-openssl-rand-hex-32

# Telegram в АГМК отключён политикой ИБ п.2.3 — переменные оставлены пустыми
AGMK_TELEGRAM_BOT_TOKEN=

# SharePoint portal (PnP scripts)
# ITOPS_TENANT_NAME — префикс тенанта для SharePoint URL, например "upmoagmk"
# (если сайт на https://upmoagmk.sharepoint.com/sites/IT-KB)
ITOPS_TENANT_NAME=${ITOPS_TENANT_NAME:-your-tenant-prefix}
