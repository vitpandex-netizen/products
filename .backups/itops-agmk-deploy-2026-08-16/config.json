    "internalLists": {
      "accessRegistry": "AccessRegistry",
      "changeLog": "ChangeLog",
      "vendors": "Vendors",
      "assets": "Assets",
      "maintenanceLog": "MaintenanceLog",
      "softwareLicenses": "SoftwareLicenses",
      "pdnSystems": "PDnSystems",
      "serverRoomVisits": "ServerRoomVisits",
      "awarenessLog": "AwarenessLog"
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "_reason": "Запрещено политикой ИБ АГМК п.2.3",
      "chatId": null,
      "botTokenEnvVar": "AGMK_TELEGRAM_BOT_TOKEN",
      "_note": "Структура готова для других деплойментов. Токен — только через env var, никогда в этот файл."
    },
    "telegramSelfService": {
      "enabled": false,
      "_reason": "Входящий self-service бот. Выключен: п.2.3 ИБ АГМК запрещает Telegram как платформу, а не конкретного бота — включение требует отдельного согласования, не решается техническим путём.",
      "botTokenEnvVar": "AGMK_TELEGRAM_SELFSERVICE_BOT_TOKEN",
      "_note": "Отдельный бот и отдельный токен от исходящего бота выше — два процесса не могут читать getUpdates одного токена."
    },
    "teams": {
      "enabled": true,
      "supportChannel": "ИТ-Поддержка"
    },
    "email": {
      "enabled": true
    },
    "forms": {
      "enabled": true
    }
  },
  "users": {
    "targetCount": 440,
    "currentCount": 330,
    "inactiveDaysThreshold": 30,
