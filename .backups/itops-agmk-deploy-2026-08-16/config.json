    "managerUpn": "${AGMK_MANAGER_UPN}",
    "buckets": [
      {
        "name": "🔴 Требует решения руководителя",
        "orderHint": 1
      },
      {
        "name": "🟡 В работе",
        "orderHint": 2
      },
      {
        "name": "🟢 Закрыто за неделю",
        "orderHint": 3
      },
      {
        "name": "📋 На контроле",
        "orderHint": 4
      }
    ]
  },
  "sharepoint": {
    "publicSite": "/sites/IT-KB",
