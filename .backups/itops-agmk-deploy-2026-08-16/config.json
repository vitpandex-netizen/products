    "internalGroupName": "IT-Internal-Ops",
    "publicSiteUrl": "https://${AGMK_TENANT_ID}.sharepoint.com/sites/IT-KB",
    "internalSiteUrl": "https://${AGMK_TENANT_ID}.sharepoint.com/sites/IT-Internal",
    "lists": {
      "tickets": "Tickets",
