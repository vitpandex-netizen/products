{
  admin off
  log {
    output file /data/access.log
    level info
  }
}

:80 {
  @health {
    path /health
  }
  handle @health {
    respond `{"status":"ok","services":["core-api","admin","query-agent","changelog","context-db","ghscout","workspace","redis","postgres","collector-pm","collector-yh","collector-bg","collector-news","analytics","trader-pm","bot"]}` 200
  }

  handle_path /api/v1/* {
    reverse_proxy core-api:8000
  }

  handle_path /query/* {
    reverse_proxy query-agent:8400
  }

  handle_path /changelog/* {
    reverse_proxy changelog:8300
  }

  handle_path /ghscout/* {
    reverse_proxy ghscout-core:8005
  }

  handle_path /workspace/* {
    reverse_proxy workspace:8007
  }

  handle_path /context/* {
    reverse_proxy context-db:8006
  }

  handle_path /admin/* {
    reverse_proxy admin:8080
  }

  handle {
    reverse_proxy admin:8080
  }
}

:9090 {
  handle /metrics {
    reverse_proxy node-exporter:9100
  }
}