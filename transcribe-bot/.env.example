# transcribe-bot — Configuration Template
# Скопируй в .env и заполни реальными значениями. .env в .gitignore.

# Токен ОТДЕЛЬНОГО бота (@you_transcriptions_bot), не общий с hh-remote-jobs —
# сознательно не шарим бота между проектами, чтобы личка не путала пользователей.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Topic "Transcribe-Service" в супергруппе "AI Assistant — Family".
# Транскрибация в самом топике больше не делается (2026-08-04) — сообщения с
# аудио там только получают редирект в личку с ботом, чтобы расшифровку видел
# только отправитель, а не вся группа.
TELEGRAM_THREAD_ID=59

# Имя сервиса transcribe-service в общей docker-сети transcribe-net
TRANSCRIBE_SERVICE_URL=http://transcribe-service:8000

# Topic "Admin" в той же супергруппе — единственное место с кнопочной
# админ-панелью (/menu): пользователи, статистика, статус сервиса.
ADMIN_THREAD_ID=66

# Telegram user_id владельцев бота (через запятую) — единственные, кто видит
# админ-панель без ограничений и может назначать/снимать роль "админ" у
# остальных. НЕ управляется через бота намеренно — правится только руками
# в .env, чтобы владельца нельзя было понизить багом или чужой кнопкой.
ADMIN_USER_IDS=

# Незнакомый пользователь, написавший боту в личку, автоматически попадает
# в очередь заявок (state.json) и в Admin-топик прилетает уведомление с
# кнопками "Разрешить"/"Отклонить" — вводить ID руками не нужно.
STATE_PATH=/data/state.json
