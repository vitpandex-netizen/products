# HH Jobs Automation Configuration
# Скопируй этот файл в .env и заполни свои значения
# НЕ коммитить .env в Git! (он в .gitignore)

# ===== HH.RU API =====
HH_API_TOKEN=your_hh_api_token_here
HH_USER_ID=your_hh_user_id_here

# ===== ПОИСК ВАКАНСИЙ =====
# Ключевые слова для поиска (через запятую)
SEARCH_KEYWORDS=python,django,fastapi

# Минимальная зарплата (в руб.)
MIN_SALARY=100000

# ID региона (1 = Москва, 2 = Санкт-Петербург, и т.д.)
SEARCH_AREA_ID=1

# За сколько дней назад искать (запас на случай если планировщик пропустил
# запуски — напр. ноутбук был выключен, а не сервер с гарантированным аптаймом)
SEARCH_PERIOD_DAYS=7

# Опыт (noExperience, between1And3, between3And6, moreThan6)
EXPERIENCE_LEVEL=between1And3

# ===== КРИТЕРИИ СОВПАДЕНИЯ =====
# Минимальный score для отправки ответа (0.0 - 1.0)
MIN_MATCH_SCORE=0.7

# Дайджест слабых совпадений (min_score..MIN_MATCH_SCORE), отдельным сообщением
DIGEST_ENABLED=true
DIGEST_MIN_SCORE=0.40

# Сколько вакансий слать за один прогон — защита от флуда при большом бэклоге
NOTIFY_BATCH_LIMIT=10
DIGEST_BATCH_LIMIT=20

# Твои основные скиллы (через запятую)
MY_SKILLS=Python,Django,FastAPI,PostgreSQL,Redis

# Сигнальные слова — небольшой бонус к score, если встречаются в описании
# (не обязательный навык, а контекст, который исторически коррелирует с
# удачными откликами, напр. "построение с нуля")
SIGNAL_KEYWORDS=

# ===== ОТПРАВКА ОТВЕТОВ =====
# Автоматически отправлять ответы (true/false)
AUTO_RESPOND_ENABLED=false

# Текст ответа (можно использовать плейсхолдеры {company}, {position})
RESPONSE_TEXT=Спасибо за интересное предложение! Я заинтересован в позиции {position} в компании {company}.

# ===== ГЕНЕРАЦИЯ ПИСЕМ =====
# Использовать OpenAI для генерации писем
USE_OPENAI=false
OPENAI_API_KEY=sk-your_openai_key_here

# Стиль письма (formal, friendly, creative)
COVER_LETTER_STYLE=formal

# ===== ЛОГИРОВАНИЕ =====
LOG_LEVEL=INFO
LOG_FILE=logs/hh-jobs.log

# ===== DATABASE =====
DB_PATH=data/hh.db

# ===== РАСПИСАНИЕ =====
# Эти переменные информационные — main.py их не читает. Реальное
# расписание задаётся внешним планировщиком (launchd/cron), см. STATUS.md.
CHECK_INTERVAL_MINUTES=30
START_HOUR=08
END_HOUR=22
