# Stocks UZ Configuration — мониторинг акций UZSE (без сделок, без бюджета)

# ===== ТИКЕРЫ =====
# Список всех 56 тикеров UZSE: см. ~/Downloads/UZSE_tickers_final_27_02_2026.xlsx
# (читается через shared/tools/uzse_ticker_file.py)
START_TICKER=HMKB
TARGET_TOP_N=10

# ===== ИСТОЧНИК ДАННЫХ =====
# Живой источник цен НЕ подтверждён на момент написания — Hermes должен
# исследовать сайт биржи (см. ~/Downloads/Республиканская фондовая биржа
# «Тошкент».mhtml) и задокументировать в STATUS.md, что реально работает.
DATA_SOURCE_URL=

# ===== СТРАТЕГИЯ =====
# Фундаментальный/долгосрочный подход (не спекуляция) — см. README.md,
# пользователь окончательно не подтвердил, может измениться.
STRATEGY=fundamental_long_term

# ===== DATABASE =====
DB_PATH=data/stocks-uz.db

# ===== ЛОГИРОВАНИЕ =====
LOG_LEVEL=INFO
LOG_FILE=logs/stocks-uz.log

# ===== РАСПИСАНИЕ =====
# Интервал обновления цены — часы работы UZSE не подтверждены, Hermes должен
# проверить на реальном сайте перед тем как выставлять окно.
UPDATE_INTERVAL_MINUTES=60

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1004297012607
TELEGRAM_THREAD_ID=80
TELEGRAM_NOTIFY_ENABLED=true
