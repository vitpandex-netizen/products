# HH Remote Jobs — Configuration Template
# Скопируй в .env и заполни реальными значениями. .env в .gitignore.

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
TELEGRAM_NOTIFY_ENABLED=true

# ===== ИСТОЧНИКИ =====
SOURCE_HH_RU_ENABLED=true
SOURCE_HH_KZ_ENABLED=true
SOURCE_TELEGRAM_CHANNELS_ENABLED=false
TELEGRAM_CHANNELS_LIST=
SOURCE_HABR_ENABLED=false

# ===== ПОИСК =====
SEARCH_KEYWORDS=IT Manager,Head of IT,IT Infrastructure Manager
SEARCH_SCHEDULE=remote
SEARCH_PERIOD_DAYS=7

# ===== ЗАРПЛАТА =====
MIN_SALARY_USD=3500
SALARY_SOFT_FLOOR_USD=2800
SALARY_TARGET_USD=5000
SALARY_ACCEPT_UNSPECIFIED=true

# ===== АНГЛИЙСКИЙ =====
REMOTE_ENGLISH_REQUIRED=false
REMOTE_ENGLISH_EXCLUDE_KEYWORDS=разговорный английский,fluent English required

# ===== КРИТЕРИИ СОВПАДЕНИЯ =====
MIN_MATCH_SCORE=0.70
DIGEST_ENABLED=true
DIGEST_MIN_SCORE=0.40
NOTIFY_BATCH_LIMIT=15
DIGEST_BATCH_LIMIT=15
MY_SKILLS=Python,Django,PostgreSQL
SIGNAL_KEYWORDS=

# ===== ИСКЛЮЧЕНИЯ =====
EXCLUDE_KEYWORDS=государственная организация,тендер,junior
HARD_STOP=релокация,вахта

# ===== ЛОГИРОВАНИЕ / БД =====
LOG_LEVEL=INFO
LOG_FILE=logs/hh-remote-jobs.log
DB_PATH=data/hh_remote.db

# ===== РАСПИСАНИЕ =====
START_HOUR=08
END_HOUR=21
