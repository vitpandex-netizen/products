# Stocks US Configuration

# ===== YAHOO FINANCE =====
# Не требуется ключ, используется yfinance (бесплатно)

# Список индексов для отслеживания
WATCH_INDICES=^GSPC,^IXIC,^DJI

# Отслеживаемые секторы
SECTORS=all  # или: technology,healthcare,finance,energy

# Минимальная капитализация компании (USD)
MIN_MARKET_CAP=1000000000

# ===== ALPHA VANTAGE API (опционально) =====
# Получи бесплатный ключ: https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=demo

# ===== FINNHUB API (опционально) =====
# Получи ключ: https://finnhub.io/
FINNHUB_API_KEY=your_key_here

# ===== КРИТЕРИИ ОТБОРА =====
# P/E ratio range
PE_RATIO_MIN=10
PE_RATIO_MAX=50

# Дивидендная доходность (%)
MIN_DIVIDEND_YIELD=1.5

# ===== ТЕХНИЧЕСКИЙ АНАЛИЗ =====
HISTORY_DAYS=252

MA_SHORT=20
MA_LONG=200

RSI_THRESHOLD_BUY=30
RSI_THRESHOLD_SELL=70

# ===== ОПОВЕЩЕНИЯ =====
ALERT_PRICE_CHANGE_PERCENT=5
ALERT_VOLUME_MULTIPLIER=1.5

# ===== ИНТЕГРАЦИЯ =====
INTEGRATE_MARKET_EVENTS=false
INTEGRATE_CRYPTO=false

# ===== DATABASE =====
DB_PATH=data/stocks-us.db

# ===== ЛОГИРОВАНИЕ =====
LOG_LEVEL=INFO
LOG_FILE=logs/stocks-us.log

# ===== РАСПИСАНИЕ =====
# Как часто обновлять (минуты)
UPDATE_INTERVAL=300

# Часовой пояс (NYC)
TIMEZONE=America/New_York

# Рабочие часы NYSE (09:30 - 16:00 EST)
MARKET_OPEN_HOUR=9
MARKET_CLOSE_HOUR=16
