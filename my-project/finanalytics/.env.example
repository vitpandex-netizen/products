# FinAnalytics Configuration

# ===== ОСНОВНЫЕ ПАРАМЕТРЫ =====
USER_ID=1
USER_CURRENCY=RUB  # RUB или USD

# ===== БАНК/КОШЕЛЬКИ =====
# Интеграция с банками (опционально)
BANK_INTEGRATION_ENABLED=false
BANK_API_KEY=your_bank_api_key

# ===== ИНВЕСТИЦИИ =====
# Синхронизация с портфелем акций
SYNC_STOCKS_RU=false
SYNC_STOCKS_US=false

# ===== ФИНАНСОВЫЕ ЦЕЛИ =====
# Сберегательные цели (%)
TARGET_SAVINGS_RATE=30

# Целевой месячный доход (руб.)
TARGET_MONTHLY_INCOME=500000

# Целевая сумма на счёте (руб.)
TARGET_EMERGENCY_FUND=500000

# ===== КАТЕГОРИИ РАСХОДОВ =====
EXPENSE_CATEGORIES=Housing,Food,Transport,Entertainment,Healthcare,Utilities,Other

# Бюджет по категориям (руб./месяц)
BUDGET_HOUSING=50000
BUDGET_FOOD=20000
BUDGET_TRANSPORT=10000
BUDGET_ENTERTAINMENT=15000
BUDGET_HEALTHCARE=5000
BUDGET_UTILITIES=5000
BUDGET_OTHER=10000

# ===== АНАЛИЗ =====
# Период истории для анализа (месяцы)
HISTORY_MONTHS=12

# Использовать ML для прогнозирования
USE_ML_FORECAST=false

# ===== ИНТЕГРАЦИЯ =====
# Интеграция с market-events для анализа влияния новостей
INTEGRATE_MARKET_EVENTS=false

# ===== DATABASE =====
DB_PATH=data/finances.db

# ===== ЛОГИРОВАНИЕ =====
LOG_LEVEL=INFO
LOG_FILE=logs/finanalytics.log

# ===== ОТЧЁТЫ =====
# Отправлять ежемесячные отчёты
SEND_MONTHLY_REPORT=false
REPORT_EMAIL=your_email@example.com

# День месяца для отправки отчёта
REPORT_DAY=1
