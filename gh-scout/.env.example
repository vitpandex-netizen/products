# GH Scout — окружение (пример)
# Скопировать в .env и заполнить реальные значения

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ghscout
POSTGRES_USER=ghscout
POSTGRES_PASSWORD=<заполни>

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

GITHUB_TOKEN=<github_pat>
TELEGRAM_BOT_TOKEN=<tg_bot_token>
TELEGRAM_CHAT_ID=-1004297012607

# Для send_digest.py
GH_SCOUT_TG_TOKEN=${TELEGRAM_BOT_TOKEN}
GH_SCOUT_TG_CHAT=${TELEGRAM_CHAT_ID}
GH_SCOUT_TG_TOPIC=203

DEBUG=false
