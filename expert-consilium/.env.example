# Expert Consilium — конфигурация

# PostgreSQL
PG_USER=consilium
PG_PASSWORD=change_me
PG_DB=consilium

# Redis
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-1004297012607
TELEGRAM_TOPIC_ID=7941

# OpenRouter (единый AI Gateway)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SITE_URL=http://100.84.223.96
SITE_NAME=ExpertConsilium

# Модели (базовые)
MODEL_STRATEGIST_BASIC=deepseek/deepseek-v4-flash
MODEL_ANALYST_BASIC=google/gemini-2.5-flash
MODEL_CRITIC_BASIC=anthropic/claude-4-haiku
MODEL_CREATIVE_BASIC=openai/gpt-4o-mini
MODEL_SYNTHESIZER_BASIC=grok/grok-3-mini

# Модели (премиум)
MODEL_STRATEGIST_PREMIUM=deepseek/deepseek-v4
MODEL_ANALYST_PREMIUM=google/gemini-2.5-pro
MODEL_CRITIC_PREMIUM=anthropic/claude-sonnet-4
MODEL_CREATIVE_PREMIUM=openai/gpt-4o
MODEL_SYNTHESIZER_PREMIUM=grok/grok-3

# Лимиты
COST_DAILY_LIMIT=0.50  # $0.50 в день
RATE_LIMIT_PER_USER=10 # запросов в минуту
MAX_QUESTION_LENGTH=5000

# Режим по умолчанию
DEFAULT_MODE=basic  # basic | premium

# Сервис
SERVICE_NAME=consilium
LOG_LEVEL=INFO
API_PORT=8007