# NOFX Configuration — секреты в vault (~/.secure/vault.enc)
# Получать через: python3 ~/.secure/vault.py get NOFX_<KEY>

# Server ports
NOFX_BACKEND_PORT=8081
NOFX_FRONTEND_PORT=3000

# Timezone
TZ=Asia/Tashkent

# Секреты — только через vault
# JWT_SECRET — vault: NOFX_JWT_SECRET
# DATA_ENCRYPTION_KEY — vault: NOFX_DATA_ENCRYPTION_KEY
# RSA_PRIVATE_KEY — vault: NOFX_RSA_PRIVATE_KEY
